{
  "name": "@oester/build-output",
  "private": true,
  "description": "Writes the Oester build output: the manifest, the static files and the server bundle",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slimluccii/oester-adapters.git",
    "directory": "packages/build-output"
  },
  "type": "module",
  "exports": {
    ".": {
      "oester-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  }
}
