{
  "name": "@oester/wald",
  "private": true,
  "description": "Deploy WaldJS sites on Oester",
  "version": "0.1.0",
  "license": "MIT",
  "keywords": [
    "waldjs",
    "wald-adapter",
    "oester"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slimluccii/oester-adapters.git",
    "directory": "packages/wald"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  },
  "peerDependencies": {
    "@waldjs/cli": ">=0.13.0"
  },
  "devDependencies": {
    "@oester/build-output": "workspace:*",
    "@waldjs/cli": "0.13.0"
  }
}
