{
  "name": "@oester/svelte",
  "description": "SvelteKit adapter for Oester",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slimluccii/oester-adapters.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/slimluccii/oester-adapters/tree/main/packages/svelte#readme",
  "bugs": "https://github.com/slimluccii/oester-adapters/issues",
  "keywords": [
    "adapter",
    "oester",
    "svelte",
    "sveltekit"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3.0.0"
  },
  "devDependencies": {
    "@oester/build-output": "workspace:*",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "vite": "8.3.4"
  }
}
