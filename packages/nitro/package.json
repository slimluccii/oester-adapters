{
  "name": "@oester/nitro",
  "private": true,
  "description": "Nitro preset that writes the Oester build output, for Nuxt and other Nitro apps",
  "version": "0.1.0",
  "license": "MIT",
  "keywords": [
    "nitro",
    "nitro-preset",
    "nuxt",
    "oester"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slimluccii/oester-adapters.git",
    "directory": "packages/nitro"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  },
  "peerDependencies": {
    "nitropack": "^2.12.0"
  },
  "devDependencies": {
    "@oester/build-output": "workspace:*",
    "nitropack": "2.13.4"
  }
}
