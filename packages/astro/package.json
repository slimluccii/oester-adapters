{
  "name": "@oester/astro",
  "description": "Astro adapter that writes the Oester build output",
  "version": "0.1.1",
  "license": "MIT",
  "keywords": [
    "astro-adapter",
    "astro-integration",
    "withastro",
    "oester"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slimluccii/oester-adapters.git",
    "directory": "packages/astro"
  },
  "homepage": "https://github.com/slimluccii/oester-adapters/tree/main/packages/astro#readme",
  "bugs": "https://github.com/slimluccii/oester-adapters/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cache": {
      "types": "./dist/runtime/cache.d.ts",
      "default": "./dist/runtime/cache.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "esbuild": "0.28.2"
  },
  "peerDependencies": {
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@oester/build-output": "workspace:*",
    "astro": "7.4.0"
  }
}
