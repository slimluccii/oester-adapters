{
  "name": "@oester/tanstack-start",
  "description": "Builds TanStack Start apps for Oester",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slimluccii/oester-adapters.git",
    "directory": "packages/tanstack-start"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oester/build-output": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-start": ">=1.169.0",
    "@tanstack/solid-start": ">=1.169.0",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-start": {
      "optional": true
    },
    "@tanstack/solid-start": {
      "optional": true
    }
  },
  "devDependencies": {
    "vite": "8.3.4"
  }
}
